{
  "$description": "ui-checks 的检查范围与验收目标。产品实现建立后把它的目录加入 goRoots/copyRoots/tokensGo，新增一个 target，并把 requireAllUITests 改为 true。",
  "requirements": "docs/design/ui-requirements.md",
  "inventory": "docs/refactor-feature-inventory.md",
  "tokens": "docs/design/tokens/tokens.json",
  "tokensCss": "docs/design/tokens/tokens.css",
  "tokensGo": [
    { "path": "prototypes/native-ui/tokens_gen.go", "package": "main" }
  ],
  "goRoots": ["prototypes/native-ui"],
  "copyRoots": ["prototypes/native-ui"],
  "forbiddenCopy": ["视为已停止", "即将推出", "敬请期待", "Coming soon", "coming soon", "发送成功"],
  "acceptance": "tools/ui-checks/acceptance",
  "requireAllUITests": false,
  "targets": [
    { "name": "native-ui-prototype", "dir": "prototypes/native-ui", "run": "TestAcceptance" }
  ]
}
